# ==============================================================================
# PrintMate — Digital Printing Guide Notebook
# Environment Variables Configuration
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (safe for client-side use)
# (from Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here
